---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site as de } from "../i18n/de";
import { site as en } from "../i18n/en";

const dict = { de, en };
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht.">
  <SiteHeader dict={dict} titleKey="nf.title" />
  <main class="container notfound">
    <h1 data-i18n="nf.h1">Seite nicht gefunden</h1>
    <p data-i18n="nf.lede">Diese Adresse gibt es hier nicht.</p>
    <p><a href="/" data-i18n="nf.home">← Zur Startseite</a></p>
  </main>
</Base>

<style is:global>
  .notfound {
    max-width: 640px;
    padding-top: 4rem;
    text-align: center;
  }
</style>
