---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AddressSearch from "../components/AddressSearch.astro";
import PlanList from "../components/PlanList.astro";
import { site as de } from "../i18n/de";
import { site as en } from "../i18n/en";

// The home page is not a brochure but a switch: start fresh, load a plan, or pick
// up where you left off. Everything else lives on /help. Texts come from
// src/i18n/{de,en}.ts, the markup only carries the keys.
// Look and feel comes from Pico (see Base.astro) — only what Pico doesn't cover lives here.
const dict = { de, en };
---

<Base
  title="Leerrohr- und Kameraplaner"
  description="Kameras, WLAN und Leerrohre maßstabsgetreu auf Luftbild und Liegenschaftskataster planen: Adresse suchen, Plan laden oder fortsetzen."
>
  <SiteHeader dict={dict} />
  <main class="container landing">
    <hgroup>
      <h1 data-i18n="head">Kamera, WLAN und Leerrohr auf einem Blatt.</h1>
      <p data-i18n="lede">
        Maßstabsgetreu auf Luftbild und Liegenschaftskataster planen: Sichtfelder prüfen, Trassen
        zeichnen, Längen und Kosten mitlaufen lassen. Läuft im Browser, ohne Konto.
      </p>
    </hgroup>

    <article>
      <header class="row">
        <span data-i18n="new.head">—</span>
        <a
          role="button"
          class="secondary outline btn-sm"
          href="/planner#new=1"
          data-i18n="foot.blank">—</a
        >
      </header>
      <AddressSearch />
    </article>

    <PlanList />

    <SiteFooter>
      <a href="/help" data-i18n="foot.guide">—</a>
    </SiteFooter>
  </main>
</Base>

<style is:global>
  .landing {
    max-width: 880px;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }
  .landing hgroup p {
    max-width: 62ch;
  }
  .landing article > header.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .landing article > header.row > .btn-sm {
    margin: -0.2rem 0;
  }
  .landing .err {
    color: var(--cam);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }
  .landing .empty {
    margin: 0;
    color: var(--ink-3);
  }
</style>
