---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { help as de } from "../i18n/de";
import { help as en } from "../i18n/en";

// Long-form guide. The short version sits in the planner behind the ? button —
// same source file, keys `help.*` there and `<name>.long` here, so both change
// together. See src/i18n/de.ts.
const dict = { de, en };
// Key, then the id the texts hang off — the same seven tools the planner has.
const tools = [
  ["V", "select"],
  ["K", "cam"],
  ["A", "ap"],
  ["J", "jb"],
  ["H", "hub"],
  ["L", "cond"],
  ["C", "cable"],
];
const keys = [
  ["Strg+Z / Strg+Y", "undo"],
  ["Entf", "del"],
  ["Esc", "esc"],
  ["⏎", "enter"],
];
const pipes = ["1", "4", "2", "3"];
---

<Base
  title="Anleitung — Leerrohr- und Kameraplaner"
  description="Werkzeuge, Tasten, Kanäle und Speichern/Teilen im Leerrohr- und Kameraplaner erklärt."
>
  <SiteHeader dict={dict}>
    <a href="/" data-i18n="back.home">← Startseite</a> ·
    <a href="/planner" data-i18n="back.app">Planer öffnen</a>
  </SiteHeader>
  <main class="container guide">
    <h1 data-i18n="h1">Anleitung</h1>

    <h2 data-i18n="sec.tools">Werkzeuge</h2>
    <p data-i18n="tools.where">—</p>
    <dl class="rows">
      {
        tools.map(([k, id]) => (
          <>
            <dt>
              <kbd>{k}</kbd> <span data-i18n={`tool.${id}`}>—</span>
            </dt>
            <dd data-i18n-html={`tool.${id}.long`}>—</dd>
          </>
        ))
      }
    </dl>

    <h2 data-i18n="sec.keys">Tasten</h2>
    <dl class="rows">
      {
        keys.map(([k, id]) => (
          <>
            <dt>
              <kbd>{k}</kbd>
            </dt>
            <dd data-i18n={`key.${id}.long`}>—</dd>
          </>
        ))
      }
      <dt><kbd data-i18n="key.dbl">Doppelklick</kbd></dt><dd data-i18n="key.dbl.long">—</dd>
    </dl>

    <h2 data-i18n="sec.pipes">Rohre und Kabel</h2>
    {pipes.map((n) => <p class={n === "2" ? "tip" : ""} data-i18n-html={`pipes.${n}.long`}>—</p>)}

    <h2 data-i18n="sec.link">Anschlüsse</h2>
    <p data-i18n-html="link.1.long">—</p>
    <p class="tip" data-i18n-html="link.2.long">—</p>
    <p data-i18n-html="link.3.long">—</p>
    <p data-i18n-html="link.4.long">—</p>
    <p data-i18n-html="mains.long">—</p>
    <p data-i18n-html="adv.long">—</p>
    <p data-i18n-html="hub.long">—</p>
    <p data-i18n-html="info.long">—</p>
    <p data-i18n-html="browse.long">—</p>

    <h2 data-i18n="sec.gear">Zentrale und Zubehör</h2>
    <p data-i18n-html="gear.long">—</p>

    <h2 data-i18n="sec.plans">Mehrere Pläne</h2>
    <p data-i18n-html="plans.long">—</p>

    <h2 data-i18n="sec.map">Karte</h2>
    <p data-i18n-html="map.long">—</p>

    <h2 data-i18n="sec.layout">Layout</h2>
    <p data-i18n-html="layout.long">—</p>

    <h2 data-i18n="sec.save">Speichern und teilen</h2>
    <p data-i18n-html="save.long">—</p>

    <h2 data-i18n="sec.cost">Kosten</h2>
    <p data-i18n-html="cost.long">—</p>

    <SiteFooter />
  </main>
</Base>

<style is:global>
  /* The back-links come from SiteHeader and already carry the top spacing. */
  .guide {
    max-width: 780px;
    padding-top: 0.5rem;
    padding-bottom: 3rem;
  }
  .guide h2 {
    font-size: 1.2rem;
    margin-top: 2rem;
  }
  .guide p strong,
  .guide p em {
    color: var(--ink);
  }
  .guide .tip {
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
  }
  .guide .rows {
    display: grid;
    grid-template-columns: minmax(130px, auto) 1fr;
    gap: 0.4rem 1rem;
  }
  .guide .rows dt,
  .guide .rows dd {
    margin: 0;
    font-size: 0.9rem;
  }
  .guide .rows dd {
    color: var(--ink-2);
  }
</style>
