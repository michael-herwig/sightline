---
// Pico CSS supplies tables, buttons, forms, cards and dark mode for the
// website. Colors come from src/styles/tokens.css, the single place where both
// themes are maintained — below they're mapped onto the --pico-* variables so
// the landing page and the app look alike.
import '@picocss/pico/css/pico.min.css';
import '@vscode/codicons/dist/codicon.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Kameras, WLAN und Leerrohre maßstabsgetreu auf Luftbild und Liegenschaftskataster planen.' } = Astro.props;
// og:url/canonical need an absolute address. Astro.site comes from
// astro.config.mjs (site: …) — so far that's just a placeholder.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  /* Map Pico onto the tokens. Applies in both themes, since the tokens themselves switch. */
  :root, :root:not([data-theme]), :root[data-theme="dark"], :root[data-theme="light"] {
    --pico-font-family: var(--sans);
    --pico-font-family-monospace: var(--mono);
    --pico-font-size: 100%;
    --pico-line-height: 1.55;
    --pico-border-radius: 8px;
    --pico-background-color: var(--ground);
    --pico-color: var(--ink);
    --pico-muted-color: var(--ink-3);
    --pico-muted-border-color: var(--line);
    --pico-card-background-color: var(--panel);
    --pico-card-sectioning-background-color: var(--panel-2);
    --pico-card-border-color: var(--line);
    --pico-card-box-shadow: var(--shadow);
    --pico-form-element-background-color: var(--panel-2);
    --pico-form-element-border-color: var(--line-2);
    --pico-form-element-color: var(--ink);
    --pico-form-element-placeholder-color: var(--ink-3);
    --pico-form-element-active-border-color: var(--accent);
    --pico-form-element-focus-color: var(--accent-soft);
    --pico-primary: var(--accent);
    --pico-primary-background: var(--accent);
    --pico-primary-border: var(--accent);
    --pico-primary-hover: var(--accent-hover);
    --pico-primary-hover-background: var(--accent-hover);
    --pico-primary-hover-border: var(--accent-hover);
    --pico-primary-underline: var(--accent-soft);
    --pico-primary-focus: var(--accent-soft);
    --pico-primary-inverse: #fff;
    --pico-secondary: var(--ink-2);
    --pico-secondary-background: var(--ink-2);
    --pico-secondary-border: var(--line-2);
    --pico-secondary-hover: var(--ink);
    --pico-secondary-hover-background: var(--ink);
    --pico-secondary-hover-border: var(--ink);
    --pico-secondary-focus: var(--accent-soft);
    --pico-secondary-inverse: var(--ground);
    --pico-contrast: var(--ink);
    --pico-contrast-background: var(--ink);
    --pico-contrast-border: var(--ink);
    --pico-contrast-hover: var(--ink-2);
    --pico-contrast-hover-background: var(--ink-2);
    --pico-contrast-hover-border: var(--ink-2);
    --pico-contrast-inverse: var(--ground);
    --pico-table-border-color: var(--line);
    --pico-table-row-stripped-background-color: var(--panel-2);
    --pico-code-background-color: var(--panel-2);
    --pico-code-color: var(--ink-2);
    --pico-dropdown-background-color: var(--panel);
    --pico-dropdown-border-color: var(--line);
    --pico-dropdown-color: var(--ink);
    --pico-dropdown-hover-background-color: var(--accent-soft);
    --pico-box-shadow: var(--shadow);
  }
  /* Small controls (language toggle, icon buttons) shouldn't be Pico-sized. */
  .btn-sm {
    --pico-form-element-spacing-vertical: 0.3rem;
    --pico-form-element-spacing-horizontal: 0.6rem;
    font-size: 0.8rem; margin: 0; width: auto;
  }
</style>
