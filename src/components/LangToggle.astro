---
// Language toggle for the website. The texts of the page travel as JSON next to
// the button; src/site/lang.ts picks them up. That keeps the logic in a bundled,
// typed module while every page still carries only its own dictionary — the
// landing page does not ship the guide.
import type { Dict } from "../site/lang";

interface Props {
  dict: { de: Dict; en: Dict };
  /** Dictionary key for <title>. The 404 page has its own. */
  titleKey?: string;
}
const { dict, titleKey } = Astro.props;
// `</script>` inside a value would end the tag early; < is valid JSON for `<`.
const payload = JSON.stringify({ ...dict, titleKey }).replace(/</g, "\\u003c");
---

<script type="application/json" id="i18n" set:html={payload} />
<button
  class="langtoggle secondary outline btn-sm"
  id="siteLang"
  type="button"
  title="Sprache umschalten"
  aria-label="Sprache umschalten">DE</button
>

<script>
  import { wireLang } from "../site/lang";
  wireLang();
</script>

<style>
  .langtoggle {
    position: fixed;
    top: 14px;
    right: 16px;
    z-index: 5;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: var(--panel);
    box-shadow: var(--shadow);
  }
</style>
